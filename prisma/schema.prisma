  @@index([companyId, assignedToId])
  @@index([threadId])
}

model CallAnalytics {
  id              String   @id @default(cuid())
  callId          String   @unique
  call            Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  // Sentiment
  overallSentiment String? @db.Text  // "positive" | "neutral" | "negative" | "mixed"
  sentimentScore   Float?  // -1 to 1
  sentimentTimeline String? @db.Text  // JSON array of { timestampSec, score }
  // Topics
  topics          String? @db.Text  // JSON array of { topic, confidence, mentions }
  // Quality
  talkToListenRatio Float?  // 0-2 (1 = balanced)
  silencePct       Float?  // 0-100
  interruptionCount Int?
  // Agent performance (if human-handled)
  agentScorecard  String? @db.Text  // JSON: { greeting, empathy, accuracy, closing } each 0-5
  // Compliance
  complianceFlags  String? @db.Text  // JSON array: ["disclosure_missing", "dnc_violation_attempt"]
  // Generated by
  generatedBy     String   @default("ai")  // ai | human
  generatedAt     DateTime @default(now())
  reviewedAt      DateTime?
  reviewedBy      String? @db.Text

  @@index([callId])
}

