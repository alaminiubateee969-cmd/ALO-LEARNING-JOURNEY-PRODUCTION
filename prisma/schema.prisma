  score          Int      @default(0)
  tasks          String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text
  results        String @default(dbgenerated("(_utf8mb4\\'{}\\')")) @db.LongText
  companyId      String
  company        MosCompany  @relation(fields: [companyId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dailyTasks SeoDailyTask[]
