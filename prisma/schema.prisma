// ==================== INVITATIONS ====================

model Invitation {
  id          String   @id @default(cuid())
  email       String
  role        String   @default("team_member")
  token       String   @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  companyId   String
  company     MosCompany  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
}

// ==================== AUDIT LOG ====================

model MosAuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String?
  details    String? @db.Text
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  companyId  String?
  company    MosCompany?  @relation(fields: [companyId], references: [id])
  createdAt  DateTime @default(now())
}

// ==================== NOTIFICATIONS ====================

model MosNotification {
  id          String    @id @default(cuid())
  userId      String                    // recipient — user who should see it
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String                    // lead.created | deal.won | ticket.assigned | campaign.completed | system | announcement
  title       String
  message     String @db.Text
  link        String? @db.Text  // URL to navigate to when clicked
  isRead      Boolean   @default(false)
  readAt      DateTime?
  metadata    String @default(dbgenerated("(_utf8mb4\\'{}\\')")) @db.LongText  // JSON: extra context
  createdAt   DateTime  @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

// ==================== MESSAGES (Chatwoot-style inbox) ====================

model Message {
  id           String    @id @default(cuid())
  content      String @db.LongText
  senderId     String
  sender       User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId  String
  recipient    User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  isRead       Boolean   @default(false)
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([senderId, recipientId])
  @@index([recipientId, isRead])
}

// ==================== ANNOUNCEMENTS ====================

model Announcement {
  id           String    @id @default(cuid())
  title        String
  content      String @db.LongText
  priority     String    @default("normal")  // low | normal | high
  targetRoles  String @default(dbgenerated("(_utf8mb4\\'all\\')")) @db.Text  // JSON array of role keys, or "all"
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  createdBy    String?
  creator      User?     @relation("AnnouncementCreator", fields: [createdBy], references: [id])
  companyId    String
  company      MosCompany   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ==================== ACTIVITY FEED (company-wide) ====================

model Activity {
  id           String    @id @default(cuid())
  companyId    String
  company      MosCompany   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?     @relation("ActivityActor", fields: [userId], references: [id])
  type         String                    // lead.created | deal.won | content.published | campaign.completed | ...
  description  String @db.Text
  resourceType String?                  // lead | deal | contact | ticket | campaign | content | ...
  resourceId   String?
  metadata     String @default(dbgenerated("(_utf8mb4\\'{}\\')")) @db.LongText  // JSON
  createdAt    DateTime  @default(now())

  @@index([companyId, createdAt])
}

// ========================================================================
// AI WORKFORCE - THE 2,000 EMPLOYEE SYSTEM
// ========================================================================

// ==================== DEPARTMENTS ====================
// Organizational departments that house AI employees

model MosDepartment {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique  // e.g. "MKT", "ENG", "FIN"
  description   String? @db.Text
  parentId      String?               // For sub-departments
  parent        MosDepartment?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children      MosDepartment[]  @relation("DeptHierarchy")
  level         Int      @default(0)  // 0=executive, 1=director, 2=department, 3=team
  sortOrder     Int      @default(0)
  icon          String?
  color         String?
  companyId     String
  company       MosCompany  @relation(fields: [companyId], references: [id])
  prompts       Prompt[] @relation("PromptDepartment")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employees     Employee[]
  sops          Sop[]
  knowledgeNodes KnowledgeNode[]
}

// ==================== EMPLOYEE (AI EMPLOYEE) ====================
// Each AI Employee is a specialized agent with identity, role, skills, KPIs

model Employee {
  id              String   @id @default(cuid())
  employeeId      String   @unique     // e.g. "EMP-0001"
  name            String
  title           String               // e.g. "Chief Marketing Officer"
  level           String   @default("specialist") // executive, director, manager, supervisor, specialist, worker
  status          String   @default("idle")       // idle, working, busy, offline, training
  avatar          String? @db.Text
  mission         String @db.Text  // What this employee exists to do
  constitution     String? @db.LongText  // Behavioral rules and constraints
  authority       String @default(dbgenerated("(_utf8mb4\\'{}\\')")) @db.Text  // JSON: what they can authorize
  permissions     String @default(dbgenerated("(_utf8mb4\\'{}\\')")) @db.Text  // JSON: RBAC permissions

  // Specialization
  departmentId    String
  department      MosDepartment @relation(fields: [departmentId], references: [id])
  reportsToId     String?
  reportsTo       Employee?  @relation("EmpHierarchy", fields: [reportsToId], references: [id])
  directReports   Employee[]  @relation("EmpHierarchy")

  // Skills & Capabilities
  skills          String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON array of skill IDs/names
  capabilities    String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: what this employee can DO
  tools           String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: tools this employee can use

  // Model Configuration
  preferredModel  String?              // Preferred AI model for this employee
  modelTier       String   @default("balanced") // fast, balanced, reasoning, coding, vision, specialized
  modelConfig     String @default(dbgenerated("(_utf8mb4\\'{}\\')")) @db.Text  // JSON: model-specific config

  // KPIs & Performance
  kpis            String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: KPI definitions
  currentKpis     String @default(dbgenerated("(_utf8mb4\\'{}\\')")) @db.Text  // JSON: current KPI values
  totalTasks      Int      @default(0)
  completedTasks  Int      @default(0)
  failedTasks     Int      @default(0)
  successRate     Float    @default(0)
  avgLatencyMs    Int      @default(0)
  lastActiveAt    DateTime?

  // Collaboration Rules
  canDelegate     Boolean  @default(false)
  canConsult      Boolean  @default(true)
  canReview       Boolean  @default(false)
  canEscalate     Boolean  @default(true)
  collaborationRules String @default(dbgenerated("(_utf8mb4\\'{}\\')")) @db.Text

  // Escalation
  escalationRules String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: when/how to escalate
  escalationPath  String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: chain of escalation

  // System
  isEnabled       Boolean  @default(true)
  isAvailable     Boolean  @default(true)
  companyId       String
  company         MosCompany  @relation(fields: [companyId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  executions      TaskExecution[]
  memories        EmployeeMemory[]
  conversations   WorkforceConversation[]
}

// ==================== TASK EXECUTION ====================
// Every task an AI employee executes is tracked here - NO FAKE DATA

model TaskExecution {
  id              String   @id @default(cuid())
  taskId          String   @unique     // External task ID

  // Task Info
  title           String
  description     String? @db.Text
  taskType        String               // e.g. "content_creation", "seo_analysis", "lead_qualification"
  complexity      String   @default("standard") // simple, standard, complex, enterprise
  executionPath   String   @default("fast")     // fast, standard, complex, enterprise
  priority        String   @default("medium")

  // Agent Assignment
  // Optional — AI agents (AiAgent table) don't have an Employee row, only the workforce does.
  // Real workforce tasks have assignedEmployeeId set; AI agent runs leave it null.
  assignedEmployeeId String?
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id])
  delegatedById     String?
  reviewedById      String?

  // Execution
  status          String   @default("pending") // pending, running, completed, failed, escalated, validated
  input           String @default(dbgenerated("(_utf8mb4\\'{}\\')")) @db.Text  // JSON: task input/context
  output          String? @db.LongText  // JSON: task result
  modelUsed       String? @db.Text  // Which model was actually used
  modelTier       String?                   // fast, balanced, reasoning, etc.
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  latencyMs       Int      @default(0)
  startedAt       DateTime?
  completedAt     DateTime?

  // Knowledge & Memory Used
  skillsUsed      String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: skills loaded
  sopsUsed        String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: SOPs followed
  knowledgeUsed   String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: knowledge nodes retrieved
  memoryUsed      String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: memory types accessed
  ragUsed         Boolean  @default(false)

  // Quality
  validationStatus String?  // passed, failed, skipped
  validationScore  Float?
  validatorId      String?
  qualityNotes     String? @db.Text

  // Self-Healing
  retryCount      Int      @default(0)
  maxRetries      Int      @default(3)
  fallbackModel   String?
  fallbackReason  String? @db.Text

  // Collaboration
  collaborationType String? // solo, delegated, consulted, parallel, synthesized
  parentTaskId     String?  // For sub-tasks
  childTaskIds     String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON
  consultedEmployees String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON

  // Learning
  lessonLearned   String? @db.Text
  improvementTags String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON

  companyId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================== EMPLOYEE MEMORY ====================
// Different memory types for each employee

model EmployeeMemory {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])

  memoryType      String               // working, episodic, semantic, procedural, department, organizational
