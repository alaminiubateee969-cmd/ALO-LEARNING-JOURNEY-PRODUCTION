// ALO Learning Journey — Prisma schema (MariaDB/MySQL)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  domain    String?
  logoUrl   String?
  plan      String   @default("growth")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIAgentRun {
  id          String    @id @default(cuid())
  agentId     String
  status      String    @default("idle")
  inputBrief  String?   @db.Text
  outputJson  String?   @db.LongText
  errorMsg    String?   @db.Text
  retryCount  Int       @default(0)
  costEstUsd  Float     @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([agentId])
  @@index([status])
}

model ContentIdea {
  id          String   @id @default(cuid())
  topic       String   @db.Text
  hook        String   @db.Text
  angle       String   @db.Text
  audience    String
  ragSources  String?  @db.Text
  status      String   @default("idea")
  createdAt   DateTime @default(now())

  @@index([status])
}

model ContentPackage {
  id             String   @id @default(cuid())
  ideaId         String?
  topic          String   @db.Text
  reelScript     String   @db.LongText
  hooksJson      String   @db.Text
  seoKeywords    String?  @db.Text
  captionsJson   String   @db.LongText
  hashtagsJson   String?  @db.Text
  imagePrompt    String?  @db.Text
  voiceDirection String?  @db.Text
  cta            String   @db.Text
  disclaimerBn   String?  @db.Text
  qualityScore   Int      @default(0)
  safetyStatus   String   @default("pending")
  ragCitations   String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([safetyStatus])
}

model ApprovalItem {
  id             String    @id @default(cuid())
  packageId      String?
  topic          String    @db.Text
  type           String    @default("content")
  title          String
  summary        String    @db.Text
  riskLevel      String    @default("low")
  blockedReasons String?   @db.Text
  requiredEdits  String?   @db.Text
  status         String    @default("pending")
  reviewerNote   String?   @db.Text
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?

  @@index([status])
}

model SocialConnection {
  id           String    @id @default(cuid())
  platform     String
  accountName  String
  handle       String?
  status       String    @default("not_connected")
  scopesJson   String?   @db.Text
  tokenExpiry  DateTime?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([platform, accountName])
}

model RagDocument {
  id         String   @id @default(cuid())
  title      String
  sourceType String   @default("manual")
  sourceUrl  String?  @db.Text
  content    String   @db.LongText
  tagsJson   String?  @db.Text
  chunkCount Int      @default(0)
  createdAt  DateTime @default(now())
}

model RagChunk {
  id           String   @id @default(cuid())
  documentId   String
  text         String   @db.LongText
  keywordsJson String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([documentId])
}

model AnalyticsSnapshot {
  id         String   @id @default(cuid())
  platform   String
  metric     String
  value      Int
  capturedAt DateTime @default(now())

  @@index([platform, metric])
}

model TelegramCommand {
  id        String   @id @default(cuid())
  command   String
  args      String?  @db.Text
  senderId  String
  status    String   @default("received")
  response  String?  @db.LongText
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String   @default("system")
  action    String
  detail    String?  @db.Text
  severity  String   @default("info")
  createdAt DateTime @default(now())

  @@index([severity])
}

model Department {
  id          String          @id @default(cuid())
  name        String
  code        String          @unique
  description String?         @db.Text
  createdAt   DateTime        @default(now())
  employees   AgentEmployee[]
}

model AgentEmployee {
  id           String         @id @default(cuid())
  name         String
  role         String
  avatar       String?
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id])
  status       String         @default("active")
  createdAt    DateTime       @default(now())
  messages     AgentMessage[]
}

model AgentMessage {
  id        String        @id @default(cuid())
  agentId   String
  agent     AgentEmployee @relation(fields: [agentId], references: [id])
  role      String        @default("agent")
  content   String        @db.LongText
  createdAt DateTime      @default(now())

  @@index([agentId])
}

model PublishedPost {
  id             String    @id @default(cuid())
  platform       String
  providerPostId String?
  postUrl        String?   @db.Text
  content        String    @db.LongText
  mediaUrlsJson  String?   @db.Text
  status         String    @default("published")
  publishedAt    DateTime  @default(now())
  performance    String?   @db.Text
}

model CommentInbox {
  id             String    @id @default(cuid())
  platform       String
  author         String
  text           String    @db.Text
  replyStatus    String    @default("pending")
  generatedReply String?   @db.Text
  sentReply      String?   @db.Text
  createdAt      DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  type      String   @default("info")
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  status      String   @default("draft")
  targetDate  DateTime?
  createdAt   DateTime @default(now())
}

model HookTest {
  id          String   @id @default(cuid())
  hookText    String   @db.Text
  score       Float    @default(0)
  variant     String   @default("A")
  createdAt   DateTime @default(now())
}

model ContentOpportunityScore {
  id          String   @id @default(cuid())
  topic       String
  score       Float    @default(0)
  factorsJson String?  @db.Text
  createdAt   DateTime @default(now())
}

model InkboxIntegration {
  id          String   @id @default(cuid())
  status      String   @default("disabled")
  endpoint    String?
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())
}

model LoopCycle {
  id          String   @id @default(cuid())
  cycleName   String
  status      String   @default("running")
  metricsJson String?  @db.Text
  createdAt   DateTime @default(now())
}

model MediaGeneration {
  id          String   @id @default(cuid())
  type        String   @default("image")
  prompt      String   @db.Text
  mediaUrl    String   @db.Text
  provider    String   @default("local")
  status      String   @default("completed")
  createdAt   DateTime @default(now())
}

model FamilyProfile {
  id          String                 @id @default(cuid())
  name        String
  role        String
  gender      String
  ageRange    String
  bio         String?                @db.Text
  avatarUrl   String?                @db.Text
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  assets      FamilyReferenceAsset[]
  projects    FamilyProject[]
}

model FamilyReferenceAsset {
  id          String        @id @default(cuid())
  profileId   String
  profile     FamilyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type        String
  filePath    String        @db.Text
  fileName    String
  fileSize    Int           @default(0)
  mimeType    String?
  createdAt   DateTime      @default(now())

  @@index([profileId])
}

model FamilyProject {
  id          String          @id @default(cuid())
  title       String
  description String?         @db.Text
  status      String          @default("draft")
  profiles    FamilyProfile[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model FamilyModel {
  id          String   @id @default(cuid())
  name        String
  version     String   @default("1.0.0")
  provider    String   @default("local")
  status      String   @default("ready")
  configJson  String?  @db.Text
  createdAt   DateTime @default(now())
}
