model SupervisorAction {
  id              String   @id @default(cuid())
  companyId       String
  company         MosCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Action
  actionType      String   // "listen" | "whisper" | "barge_in" | "take_over" | "force_transfer" | "force_release"
  callId          String?
  agentUserId     String?  // human agent being supervised
