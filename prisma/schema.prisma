  // Audit (per directive §5: manual adjustments with audit logs)
  createdBy       String
  creator         User     @relation("BillingAdjustmentCreator", fields: [createdBy], references: [id])
  approvedBy      String?
  approver        User?    @relation("BillingAdjustmentApprover", fields: [approvedBy], references: [id])
  createdAt       DateTime @default(now())

  @@index([companyId, createdAt])
