model SubscriptionPlan {
  id              String   @id @default(cuid())
  name            String   @unique
  displayName     String
  description     String? @db.Text
  // Pricing (USD/month)
  priceMonthly    Float    @default(0)
  priceYearly     Float    @default(0)
  // Limits
  maxPhoneNumbers Int      @default(1)
  maxUsers        Int      @default(3)
  maxAiMinutes    Int      @default(100)
  maxTtsCharacters Int     @default(10000)
  maxAsrSeconds   Int      @default(3600)
  maxRecordingStorageMb Int @default(500)
  maxOutboundCallsPerDay Int @default(50)
  // Features (JSON array of feature flags)
  features        String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text
  // Trial
  trialDays       Int      @default(0)
  // Status
  isPublic        Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
