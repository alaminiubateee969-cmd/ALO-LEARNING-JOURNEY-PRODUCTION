// ==================== SKILLS + PROMPTS + AGENT PROFILES ====================
// Comprehensive skill registry + prompt library + AI Agent profiles (2,000)

model Skill {
  id              String   @id @default(cuid())
  name            String   @unique
  displayName     String
  category        String   // marketing, sales, engineering, finance, operations, support, creative, data, security, management
  subcategory     String?
  description     String @db.Text
  proficiencyLevels String @default(dbgenerated("(_utf8mb4\\'[\"beginner\",\"intermediate\",\"advanced\",\"expert\"]\\')")) @db.Text
  prerequisites   String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: skill IDs required before this
  tools           String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: tool names this skill uses
  isActive        Boolean  @default(true)
  companyId       String?
  company         MosCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category, isActive])
}

model Prompt {
  id              String   @id @default(cuid())
  name            String
  category        String   // system, task, role, instruction, template
  subcategory     String?
  content         String @db.LongText  // The prompt text (with {{variables}})
  variables       String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: list of template variables
  language        String   @default("en")
  tags            String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON
  companyId       String?
  company         MosCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  departmentId    String?
  department      MosDepartment? @relation("PromptDepartment", fields: [departmentId], references: [id])
  applicableRoles String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: employee levels
  version         Int      @default(1)
  isActive        Boolean  @default(true)
  useCount       Int      @default(0)
  rating          Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category, isActive])
  @@index([departmentId])
}

model AgentProfile {
  id              String   @id @default(cuid())
  agentId         String   @unique  // Links to Employee.employeeId (EMP-XXXX)
  name            String
  role            String   // Chief Marketing Officer, SEO Specialist, etc.
  department      String
  level           String   // executive, director, manager, supervisor, specialist, worker

  // Capabilities
  skillsJson     String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: array of skill names
  toolsJson      String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: array of tool names
  promptsJson    String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: array of prompt IDs
  sopsJson       String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: array of SOP IDs

  // Model config
  modelTier      String   @default("balanced")
  preferredModel String?

  // Knowledge + Memory
  knowledgeBaseIds String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: knowledge node IDs
  memoryType     String   @default("episodic")  // episodic, semantic, procedural, working

  // Behavior
  constitution   String @default(dbgenerated("(_utf8mb4\\'\\')")) @db.LongText  // Behavioral rules
  authority      String @default(dbgenerated("(_utf8mb4\\'{}\\')")) @db.Text  // JSON: what they can authorize
  kpisJson       String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: KPI definitions
  collaborationRules String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: who they can collaborate with
  escalationRules String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON: when to escalate

  // Status
  isActive       Boolean  @default(true)
  totalExecutions Int     @default(0)
  successRate   Float     @default(100)
  avgLatencyMs  Int       @default(0)

  companyId      String
  company        MosCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId, isActive])
  @@index([companyId, department])
}
