// ALO Learning Journey — Prisma schema (MySQL)
// Operational data layer. The agent roster is a static config module
// (src/lib/agents.ts) so it stays richly typed and always available even
// before the DB is seeded. Runs, content, approvals, RAG, analytics etc.
// are persisted here.

generator client {
  provider      = "prisma-client-js"
  // Added rhel-openssl-* for CloudLinux/cPanel (RHEL-based) hosts like 115.187.18.53
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  domain    String?
  logoUrl   String?
  plan      String   @default("growth")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]
}

model AIAgentRun {
  id          String   @id @default(cuid())
  agentId     String
  status      String   @default("idle") // idle | running | success | failed | blocked_external_setup
  inputBrief String? @db.Text
  outputJson String? @db.LongText
  errorMsg String? @db.Text
  retryCount  Int      @default(0)
  costEstUsd  Float    @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([agentId])
  @@index([status])
}

model AdminOtpChallenge {
  id              String    @id @default(cuid())
  phoneHash       String    @unique
  otpHash         String
  expiresAt       DateTime
  consumedAt      DateTime?
  failedAttempts  Int       @default(0)
  sentAt          DateTime?
  windowStartedAt DateTime  @default(now())
  sendCount       Int       @default(0)

  @@index([expiresAt, consumedAt])
}

model ContentIdea {
  id          String   @id @default(cuid())
  topic       String
  hook String @db.Text
  angle String @db.Text
  audience    String
  ragSources String? @db.Text // JSON array of source titles
  status      String   @default("idea") // idea | packaged | approved | published | rejected
  createdAt   DateTime @default(now())

  @@index([status])
}

model ContentPackage {
  id           String   @id @default(cuid())
  ideaId       String?
  topic        String
  reelScript String @db.LongText
  hooksJson String @db.LongText // JSON: string[]
  seoKeywords String? @db.Text // JSON: string[]
  captionsJson String @db.LongText // JSON: { platform: caption }
  hashtagsJson String? @db.Text // JSON: string[]
  imagePrompt String? @db.Text
  voiceDirection String? @db.Text
  cta String @db.Text
  disclaimerBn String? @db.Text
  qualityScore Int      @default(0)
  safetyStatus String   @default("pending") // pending | safe | needs_revision | blocked
  ragCitations String? @db.Text // JSON
  createdAt    DateTime @default(now())

  @@index([safetyStatus])
}

model ApprovalItem {
  id            String   @id @default(cuid())
  packageId     String?
  topic         String
  type          String   @default("content") // content | comment | image | voice | video
  title         String
  summary String @db.Text
  riskLevel     String   @default("low") // low | medium | high
  blockedReasons String? @db.Text // JSON array
  requiredEdits String? @db.Text // JSON array
  status        String   @default("pending") // pending | approved | rejected | revised
  reviewerNote String? @db.Text
  createdAt     DateTime @default(now())
  reviewedAt    DateTime?

  @@index([status])
}

model SocialConnection {
  id           String   @id @default(cuid())
  platform     String   // facebook | instagram | youtube | tiktok | linkedin | x | whatsapp | telegram | pinterest | threads | gbp
  accountName  String
  handle        String?
  status       String   @default("not_connected") // not_connected | connected | external_setup_required | expired | revoked | failed
  scopesJson String? @db.Text
  tokenExpiry  DateTime?
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([platform, accountName])
}

model RagDocument {
  id         String   @id @default(cuid())
  title      String
  sourceType String   @default("manual") // manual | pdf | docx | csv | url | faq | policy
  sourceUrl  String?
  content String @db.LongText
  tagsJson String? @db.Text // JSON array
  chunkCount Int      @default(0)
  createdAt  DateTime @default(now())
}

model RagChunk {
  id          String   @id @default(cuid())
  documentId  String
  text String @db.LongText
  keywordsJson String? @db.Text // JSON array
  createdAt   DateTime @default(now())

  @@index([documentId])
}

model AnalyticsSnapshot {
  id           String   @id @default(cuid())
  platform     String
  metric       String   // views | reach | watch_time | retention | shares | saves | leads | comments | followers
  value        Int
  capturedAt   DateTime @default(now())

  @@index([platform, metric])
}

model TelegramCommand {
  id         String   @id @default(cuid())
  command    String
  args String? @db.Text
  senderId   String
  status     String   @default("received") // received | executed | rejected | unknown
  response String? @db.Text
  createdAt  DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String   @default("system")
  action     String
  detail String? @db.Text
  severity   String   @default("info") // info | warn | error | critical
  createdAt  DateTime @default(now())

  @@index([severity])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  body String @db.Text
  kind      String   @default("info") // info | success | warn | danger
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FamilyModel {
  id               String   @id @default(cuid())
  characterName    String
  personType       String   // baby_girl | mother | father | teacher | narrator | user_owned
  consentConfirmed Boolean  @default(false)
  consentDate      DateTime?
  referenceImages String? @db.Text // JSON array of urls
  voiceSample      String?
  appearanceJson String? @db.Text
  voiceSettingsJson String? @db.Text
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model PublishedPost {
  id          String   @id @default(cuid())
  platform    String
  providerPostId String?
  url         String?
  topic       String
  status      String   @default("queued") // queued | scheduled | publishing | published | failed | external_setup_required
  createdAt   DateTime @default(now())
  publishedAt DateTime?
  scheduledAt DateTime?
  packageId   String?

  @@index([status])
  @@index([platform])
}

model CommentInbox {
  id           String   @id @default(cuid())
  platform     String
  authorName   String
  authorHandle String?
  text String @db.Text
  postTopic    String?
  category     String   @default("safe_general")
  riskLevel    String   @default("low")
  status       String   @default("new")
  draftReply String? @db.Text
  createdAt    DateTime @default(now())
  repliedAt    DateTime?

  @@index([status])
  @@index([category])
}

// ===== Workforce Architecture (2,000 AI Employee scale) =====

model Department {
  id          String   @id @default(cuid())
  name        String
  family      String   // CONTENT_STRATEGY | SOCIAL_MEDIA | IMAGE | VIDEO | VOICE | etc.
  description String? @db.Text
  agentCount  Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([family])
}

model AgentEmployee {
  id            String   @id @default(cuid())
  departmentId  String
  name          String
  role          String
  specialization String
  capabilities  String   // JSON: ["TEXT","IMAGE","VIDEO","VOICE","CALL","SMS","SOCIAL","ANALYTICS","RESEARCH","QA"]
  tools String @db.Text // JSON array
  modelProvider String   @default("local")
  modelName     String   @default("local")
  qualityScore  Float    @default(0)
  successRate   Float    @default(0)
  status        String   @default("idle") // idle | active | busy | failed | suspended
  sopCoverage   Float    @default(0)
  maxAttempts   Int      @default(3)
  createdAt     DateTime @default(now())

  @@index([departmentId])
  @@index([status])
  @@index([capabilities])
}

model LoopCycle {
  id          String   @id @default(cuid())
  objective String @db.Text
  phase       String   @default("observe") // observe|understand|plan|delegate|create|verify|critique|correct|evaluate|publish|learn
  status      String   @default("running") // running|completed|failed|escalated
  agentsUsed String? @db.Text // JSON array of agent IDs
  qualityScore Float   @default(0)
  retryCount  Int      @default(0)
  costUsd     Float    @default(0)
  errorType   String?
  lesson String? @db.Text
  startedAt   DateTime @default(now())
  completedAt DateTime?

  @@index([status])
  @@index([phase])
}

// ===== Private Family AI Studio =====

model FamilyProfile {
  id               String   @id @default(cuid())
  personName       String
  personType       String   // me | wife | child
  consentConfirmed Boolean  @default(false)
  consentDate      DateTime?
  guardianName     String?  // required if personType=child
  voiceConsent     Boolean  @default(false)
  faceConsent      Boolean  @default(false)
  appearanceJson String? @db.Text // JSON: hair, eyes, build, etc.
  voiceSettingsJson String? @db.Text
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  referenceAssets FamilyReferenceAsset[]
  projects        FamilyProject[]

  @@index([personType])
}

model FamilyReferenceAsset {
  id            String   @id @default(cuid())
  profileId     String
  profile       FamilyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assetType     String   // photo | video | voice
  angleType     String?  // front | left | right | three_quarter | full_body | close_up
  context       String?  // indoor | outdoor | casual | formal
  expression    String?  // smiling | neutral | surprised | etc.
  lighting      String?  // natural | studio | low_light | golden_hour
  clothing      String?  // casual | formal | sportswear | traditional
  hairstyle     String?  // description
  filePath      String
  fileName      String?  // original filename
  fileSize      Int      @default(0) // bytes
  mimeType      String?  // image/jpeg | video/mp4 | audio/wav
  qualityScore  Float    @default(0) // 0=blurry/low, 1=high
  isDuplicate   Boolean  @default(false)
  approved      Boolean  @default(false) // admin-approved for use
  uploadedAt    DateTime @default(now())

  @@index([profileId])
  @@index([assetType])
  @@index([approved])
}

model FamilyProject {
  id            String   @id @default(cuid())
  title         String
  description String? @db.Text
  prompt String @db.Text // user's one-click prompt
  castProfileIds String @db.Text // JSON array of FamilyProfile IDs
  status        String   @default("draft") // draft|running|completed|failed
  qualityScore  Float    @default(0)
  currentStage  String?  // creative_director|script|storyboard|...|final_director
  outputJson String? @db.LongText // JSON: generated outputs per stage
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profiles      FamilyProfile[]

  @@index([status])
}

model MediaGeneration {
  id            String   @id @default(cuid())
  projectId     String?
  stage         String   // script|storyboard|image|video|voice|lip_sync|edit|upscale
  inputJson String? @db.Text // JSON: input params
  outputJson String? @db.LongText // JSON: generated output
  qualityScore  Float    @default(0)
  identityScore Float    @default(0) // face/likeness consistency 0-1
  provider      String   @default("local")
  status        String   @default("pending") // pending|running|passed|failed|regenerated
  attempt       Int      @default(1)
  maxAttempts   Int      @default(3)
  issuesJson String? @db.Text // JSON array of quality issues
  createdAt     DateTime @default(now())

  @@index([projectId])
  @@index([stage])
  @@index([status])
}

// ===== Growth Loop: Content Opportunity + Hook Testing + Campaigns =====

model ContentOpportunityScore {
  id                  String   @id @default(cuid())
  topic               String
  searchDemand        Int      @default(0)   // 0-100
  parentRelevance     Int      @default(0)   // 0-100
  bangladeshRelevance Int      @default(0)   // 0-100
  competition          Int      @default(0)   // 0-100 (higher = harder)
  videoPotential      Int      @default(0)   // 0-100
  brandFit            Int      @default(0)   // 0-100
  finalScore          Int      @default(0)   // weighted average
  rationale String? @db.Text
  approved            Boolean  @default(false) // only high-score topics enter production
  provider            String   @default("local")
  createdAt           DateTime @default(now())

  @@index([approved])
  @@index([finalScore])
}

model HookTest {
  id            String   @id @default(cuid())
  topic         String
  hookText String @db.Text
  variant       String   @default("A") // A | B | C | D | E
  impressions   Int      @default(0)
  hookRetention Float    @default(0)   // 3-sec retention %
  watchTime     Int      @default(0)   // avg seconds
  completion    Float    @default(0)   // %
  isWinner      Boolean  @default(false)
  status        String   @default("draft") // draft | testing | completed | winner
  createdAt     DateTime @default(now())
  testedAt      DateTime?

  @@index([topic])
  @@index([status])
}

model Campaign {
  id            String   @id @default(cuid())
  title         String
  topic         String
  opportunityId String?
  status        String   @default("planned") // planned|in_production|published|measured|learned
  platformCount Int      @default(0)
  totalAssets   Int      @default(0)
  views         Int      @default(0)
  reach         Int      @default(0)
  engagement    Float    @default(0)
  followerGain  Int      @default(0)
  audienceRelevance Float @default(0) // % relevant parents
  conversionRate Float   @default(0)
  lesson String? @db.Text
  createdAt     DateTime @default(now())
  publishedAt   DateTime?
  measuredAt    DateTime?

  @@index([status])
}

// ===== Inkbox Adapter Layer (OPTIONAL — ALO works without it) =====

model InkboxIntegration {
  id            String   @id @default(cuid())
  name          String
  agentId       String
  inkboxIdentityId String?
  channels      String   @default("[]")
  status        String   @default("not_connected")
  configJson String? @db.Text
  lastHealthCheck DateTime?
  lastError String? @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([agentId])
}

model AgentMessage {
  id            String   @id @default(cuid())
  senderAgentId String
  recipientAgentId String
  taskId        String?
  objective String @db.Text
  context String? @db.Text
  requiredOutput String? @db.Text
  priority      String   @default("normal")
  status        String   @default("pending")
  result String? @db.LongText
  failureReason String? @db.Text
  hopCount      Int      @default(0)
  channel       String   @default("internal")
  inkboxMessageId String?
  createdAt     DateTime @default(now())
  deliveredAt   DateTime?
  completedAt   DateTime?

  @@index([senderAgentId])
  @@index([recipientAgentId])
  @@index([status])
  @@index([taskId])
}

// ===== Admissions CRM + Quote management =====
// Personal data is limited to enquiry/contact fields. Do not use these records
// for passport, immigration case files, health data, or other special-category data.
model Lead {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fullName         String
  email            String?
  phone            String?
  targetCountry    String?
  studyLevel       String?
  courseInterest   String?
  intake           String?
  source           String   @default("website") // website | referral | social | event | partner | other
  stage            String   @default("new") // new | contacted | qualified | consultation_booked | proposal_sent | enrolled | lost
  consentStatus    String   @default("unknown") // unknown | consented | opted_out
  consentRecordedAt DateTime?
  nextFollowUp     DateTime?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  activities LeadActivity[]
  quotations Quotation[]

  @@index([companyId, stage])
  @@index([companyId, nextFollowUp])
  @@index([companyId, createdAt])
  @@index([email])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String   @default("note") // created | note | call | email | whatsapp | meeting | follow_up | stage_change | quotation
  body      String   @db.Text
  actor     String   @default("admin")
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model Quotation {
  id             String   @id @default(cuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  number         String   @unique
  title          String
  currency       String   @default("GBP") // GBP | USD | EUR | BDT
  status         String   @default("draft") // draft | sent | accepted | declined | expired
  subtotal       Decimal  @default(0) @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @default(0) @db.Decimal(12, 2)
  validUntil     DateTime?
  terms          String?  @db.Text
  notes          String?  @db.Text
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items QuotationItem[]

  @@index([leadId, status])
  @@index([createdAt])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  quantity    Int       @default(1)
  unitPrice   Decimal   @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal   @default(0) @db.Decimal(12, 2)
  position    Int       @default(0)

  @@index([quotationId, position])
}

// ===== v2 additive models; admissions Lead remains a separate model/table. =====

model Client {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  phone       String?
  company     String?
  type        String   @default("individual") // individual|company
  status      String   @default("active") // active|inactive|blocked
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model Project {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  service     String   // website|crm|automation|ai|video|seo
  status      String   @default("inquiry") // inquiry|proposal|approved|development|review|deployment|completed|maintenance
  budget      Float?
  deadline    DateTime?
  description String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

model Invoice {
  id          String   @id @default(cuid())
  clientId    String
  projectId   String?
  amount      Float
  currency    String   @default("BDT")
  status      String   @default("draft") // draft|sent|paid|overdue|cancelled
  dueDate     DateTime?
  paidAt      DateTime?
  itemsJson   String?  @db.Text // JSON: [{description, quantity, price}]
  createdAt   DateTime @default(now())

  @@index([clientId])
  @@index([status])
}

model MarketingCampaign {
  id          String   @id @default(cuid())
  name        String
  channel     String   // email|whatsapp|social|sms
  status      String   @default("draft") // draft|scheduled|running|completed|paused
  audienceJson String? @db.Text // JSON: target criteria
  content     String?  @db.Text
  scheduledAt DateTime?
  sentCount   Int      @default(0)
  openCount   Int      @default(0)
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([channel])
}

model OtpRequest {
  id          String   @id @default(cuid())
  channel     String   // sms|email|whatsapp|voice
  recipientHash  String   // keyed hash of normalized address/number; raw PII is not persisted
  recipientLabel String   // masked display value, never the full address/number
  codeHash       String   // keyed hash only; raw OTP codes are never persisted
  purpose     String   @default("verification") // verification|login|transaction|reset
  status      String   @default("pending") // pending|delivered|verified|expired|failed
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  expiresAt   DateTime
  verifiedAt  DateTime?
  metadataJson String? @db.Text // provider, message_id, cost etc.
  createdAt   DateTime @default(now())

  @@index([recipientHash])
  @@index([status])
  @@index([expiresAt])
}

model VoiceGeneration {
  id           String   @id @default(cuid())
  text         String   @db.LongText
  voice        String   // tongtong|chuichui|xiaochen|jam|kazi|douji|luodo
  speed        Float    @default(1.0)
  volume       Float    @default(1.0)
  format       String   @default("wav") // wav|mp3|pcm
  language     String   @default("bn") // bn|en|zh
  filePath     String?
  durationSec  Float?
  charCount    Int      @default(0)
  status       String   @default("pending") // pending|completed|failed
  errorMessage String? @db.Text
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([voice])
}

model AudioTranscription {
  id           String   @id @default(cuid())
  fileName     String
  fileSize     Int
  format       String   // wav|mp3|m4a|flac|ogg
  language     String   @default("auto")
  transcription String? @db.LongText
  wordCount    Int      @default(0)
  durationSec  Float?
  status       String   @default("pending") // pending|completed|failed
  errorMessage String? @db.Text
  createdAt    DateTime @default(now())

  @@index([status])
}

model HumanAvatar {
  id              String   @id @default(cuid())
  ownerId         String   @default("dev-admin") // tenant/owner isolation
  name            String   // e.g. "আদিত্য", "মেঘা", "Rahim Sir"
  persona         String   // mother | father | teacher | narrator | doctor | expert
  gender          String   // male | female
  ageRange        String   // e.g. "28-35"
  ethnicity       String   @default("south-asian") // south-asian | bengali | mixed
  faceDescription String   @db.Text // detailed facial features for consistency
  voiceProfile    String   // tongtong|chuichui|xiaochen|jam|kazi|douji|luodo
  voiceSpeed      Float    @default(0.95)
  backgroundStory String?  @db.Text // persona backstory for LLM context
  consistencySeed String?  // hash to keep face consistent across regen
  portraitUrl     String?  // generated portrait image url
  portraitStatus  String   @default("pending") // pending|generated|failed
  outfitStyle     String?  // e.g. "saree", "salwar kameez", "shirt"
  sceneContext    String?  // e.g. "home study room", "outdoor garden"
  active          Boolean  @default(true)
  videoCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  videos          AvatarVideo[]

  @@index([ownerId])
  @@index([persona])
  @@index([active])
}

model AvatarVideo {
  id              String   @id @default(cuid())
  ownerId         String   @default("dev-admin") // tenant/owner isolation
  avatarId        String
  avatar          HumanAvatar @relation(fields: [avatarId], references: [id], onDelete: Restrict)
  prompt          String   @db.Text // user's original instruction
  script          String?  @db.LongText // LLM-generated full script (Bengali)
  scenesJson      String?  @db.LongText // JSON: [{text, imageUrl, audioUrl, durationSec}]
  targetDuration  Int      // seconds (300-3600)
  actualDuration  Float?   // measured final duration
  videoUrl        String?
  thumbnailUrl    String?
  status          String   @default("pending") // pending|scripting|generating_audio|generating_images|composing|completed|failed
  progress        Int      @default(0) // 0-100
  currentStep     String?
  errorMessage    String?
  lipSyncUsed     Boolean  @default(false) // true if Wav2Lip applied
  lipSyncReason   String?  // success|not_configured|http_error|invalid_output|timeout|provider_error
  quality         String   @default("standard") // standard|hd|cinematic
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerId])
  @@index([avatarId])
  @@index([status])
}

model MarketingLead {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  company     String?
  source      String   @default("website") // website|whatsapp|telegram|referral|ads
  service     String?  // website|crm|automation|ai|video|seo
  budget      String?  // low|medium|high|enterprise
  status      String   @default("new") // new|qualified|proposal|negotiation|won|lost
  assignedTo  String?  // staff member
  notes       String?  @db.Text
  tagsJson    String?  @db.Text  // JSON array
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([source])
}

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║ MarketingOS / AI-workforce models (integrated in PR #27, 0ab0c7d)        ║
// ╚══════════════════════════════════════════════════════════════════════════╝
// These models were written for SQLite and are stored in the same MySQL
// database as the ALO models above, in additive tables only (see migration
// 20261111000000_marketingos_workforce_tables). Eight model names collided
// with ALO models that already own production tables, so the MarketingOS
// copies are prefixed `Mos` (Company, Lead, LeadActivity, Campaign,
// Notification, AuditLog, Department, Invoice). Relation field names are
// unchanged. Long/JSON strings use TEXT/LONGTEXT; string defaults on TEXT
// columns are expression defaults because MySQL 8 rejects literal ones.
//
// Those defaults are written exactly as MySQL 8 reports them back to Prisma
// (`(_utf8mb4\'[]\')` for SQL `DEFAULT ('[]')`), which is also what
// `prisma db pull` produces; any other spelling makes `prisma migrate diff`
// and `migrate dev` report drift on every run. Prisma copies the string into
// generated SQL verbatim and MySQL cannot parse it there, so a migration that
// adds such a column must spell the default `DEFAULT ('[]')` by hand.
// scripts/verify-migrations.mjs enforces both halves.

// ==================== MULTI-TENANT COMPANY ====================

model MosCompany {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String? @db.Text
  website     String? @db.Text
  industry    String?
  country     String?
  brandColors String? @db.Text
  targetAudience String? @db.Text
  marketingGoals String? @db.Text
  plan        String   @default("free")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         CompanyUser[]
  socialAccounts SocialAccount[]
  campaigns     MosCampaign[]
  contents      Content[]
  seoChallenges SeoChallenge[]
  leads         MosLead[]
  contacts      Contact[]
  deals         Deal[]
  tickets       Ticket[]
  aiAgents      AiAgent[]
  auditLogs     MosAuditLog[]
  subscriptions Subscription[]
  invitations   Invitation[]
  departments   MosDepartment[]
  employees     Employee[]
  knowledgeNodes KnowledgeNode[]
  toolConnections ToolConnection[]
  webhooks        Webhook[]
  apiKeys         ApiKey[]
  announcements   Announcement[]
  activities      Activity[]
  feedSources     FeedSource[]
  feedItems       FeedItem[]
  smsMessages     SmsMessage[]
  competitors     Competitor[]
  keywordTrackers KeywordTracker[]
  workflows       Workflow[]
  workflowRuns    WorkflowRun[]
  integrations    Integration[]
  oauthStates     OAuthState[]
  integrationManifests IntegrationManifest[]
  agentModelAssignments AgentModelAssignment[]
  agentUsageDailies AgentUsageDaily[]
  agentExecutionLogs  AgentExecutionLog[]
  afterHoursRule  AfterHoursRule[]
  // Phase 1-6 voice/contact-center relations
  voiceAgents     VoiceAgent[]
  consents        Consent[]
  callUsageDailies CallUsageDaily[]
  ttsUsageDailies TtsUsageDaily[]
  asrUsageDailies AsrUsageDaily[]
  phoneNumbers    PhoneNumber[]
  calls           Call[]
  ivrMenus        IvrMenu[]
  ringGroups      RingGroup[]
  callQueues      CallQueue[]
  voicemails      Voicemail[]
  voiceCloneAuthorizations VoiceCloneAuthorization[]
  pronunciationDictionaries PronunciationDictionary[]
  ttsJobs         TtsJob[]
  outboundCampaigns OutboundCampaign[]
  agentStatuses   AgentStatus[]
  supervisorActions SupervisorAction[]
  customers       Customer[]
  sharedInboxMessages SharedInboxMessage[]
  knowledgeBases  KnowledgeBase[]
  subscription    TenantSubscription?
  usageCredits    UsageCredit[]
  invoices        MosInvoice[]
  payments       Payment[]
  billingAdjustments BillingAdjustment[]
  expenses     Expense[]
  skills       Skill[]
  prompts      Prompt[]
  agentProfiles AgentProfile[]
}

// ==================== USER & ROLES ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  avatar        String? @db.Text
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  companyUsers  CompanyUser[]
  auditLogs     MosAuditLog[]
  aiChatMessages AiChatMessage[]
  createdContents Content[] @relation("ContentCreator")
  sessions      UserSession[]
  notifications  MosNotification[]  // notifications addressed to this user
  sentMessages   Message[]  @relation("MessageSender")
  receivedMessages Message[] @relation("MessageRecipient")
  announcements  Announcement[] @relation("AnnouncementCreator")
  activities     Activity[] @relation("ActivityActor")
  sentSms        SmsMessage[] @relation("SmsSender")
  createdWorkflows Workflow[] @relation("WorkflowCreator")
  integrationCreated  Integration[] @relation("IntegrationCreator")
  integrationUpdated  Integration[] @relation("IntegrationUpdater")
  oauthStates         OAuthState[] @relation("OAuthStateUser")
  confirmedManifests  IntegrationManifest[] @relation("ManifestConfirmer")
  createdAiProviders  AiModelProvider[] @relation("AiModelProviderCreator")
  updatedAiProviders  AiModelProvider[] @relation("AiModelProviderUpdater")
  createdAgentAssignments  AgentModelAssignment[] @relation("AgentAssignmentCreator")
  updatedAgentAssignments  AgentModelAssignment[] @relation("AgentAssignmentUpdater")
  agentExecutionLogs  AgentExecutionLog[] @relation("AgentExecutionActor")
  // Phase 1-6 voice/contact-center relations
  mfaSecret       MfaSecret?   @relation("MfaSecretUser")
  refreshTokens   RefreshToken[] @relation("RefreshTokenUser")
  createdVoiceAgents VoiceAgent[] @relation("VoiceAgentCreator")
  updatedVoiceAgents VoiceAgent[] @relation("VoiceAgentUpdater")
  createdPhoneNumbers PhoneNumber[] @relation("PhoneNumberCreator")
  createdCalls    Call[]  @relation("CallCreator")
  createdIvrMenus IvrMenu[] @relation("IvrMenuCreator")
  capturedVoiceCloneAuths VoiceCloneAuthorization[] @relation("VoiceCloneAuthCreator")
  createdTtsJobs  TtsJob[] @relation("TtsJobCreator")
  createdCampaigns OutboundCampaign[] @relation("CampaignCreator")
  agentStatus     AgentStatus?  @relation("AgentStatusUser")
  supervisorActions SupervisorAction[] @relation("SupervisorActor")
  createdCustomers Customer[] @relation("CustomerCreator")
  uploadedKnowledgeDocs KnowledgeDocument[] @relation("KnowledgeDocCreator")
  createdPayments Payment[] @relation("PaymentCreator")
  createdBillingAdjustments BillingAdjustment[] @relation("BillingAdjustmentCreator")
  approvedBillingAdjustments BillingAdjustment[] @relation("BillingAdjustmentApprover")
  createdExpenses Expense[] @relation("ExpenseCreator")
}

model CompanyUser {
  id          String   @id @default(cuid())
  role        String   @default("team_member")
  permissions String @default(dbgenerated("(_utf8mb4\\'{}\\')")) @db.Text
  joinedAt    DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  companyId   String
  company     MosCompany  @relation(fields: [companyId], references: [id])

  leadsAssigned      MosLead[]  @relation("LeadAssignee")
  ticketsAssigned    Ticket[] @relation("TicketAssignee")
