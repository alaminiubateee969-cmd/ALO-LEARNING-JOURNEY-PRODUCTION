// ==================== PHASE 4: AI CALL AGENTS ====================

model OutboundCampaign {
  id              String   @id @default(cuid())
  companyId       String
  company         MosCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  description     String? @db.Text
  // Script
  script          String @default(dbgenerated("(_utf8mb4\\'\\')")) @db.LongText  // conversation flow
  agentId         String?  // voice agent that runs the campaign
  // Contact list
  contactListId   String?  // reference to lead list filter
  // Schedule
  startAt         DateTime?
  endAt           DateTime?
  callingWindowStart String @default("09:00")  // local time
  callingWindowEnd String  @default("18:00")
  callingDays     String @default(dbgenerated("(_utf8mb4\\'[1,2,3,4,5]\\')")) @db.Text
  timezone        String   @default("Asia/Dhaka")
  // Compliance
  dncSuppression  Boolean  @default(true)
  consentRequired Boolean  @default(true)
  maxAttemptsPerContact Int @default(3)
  retryDelayHours Int      @default(24)
  // Status
  status          String   @default("draft")  // draft | scheduled | running | paused | completed | cancelled
  startedAt       DateTime?
  completedAt     DateTime?
  // Metrics
  totalContacts   Int      @default(0)
  callsAttempted  Int      @default(0)
  callsConnected  Int      @default(0)
  callsAnswered   Int      @default(0)
  // Audit
  createdBy       String?
  creator         User?    @relation("CampaignCreator", fields: [createdBy], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, status])
  calls           CampaignCall[]
}

model CampaignCall {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        OutboundCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Contact
  leadId          String?
  contactId       String?
  toNumber        String
  // Execution
  callId          String?  // FK to Call row when call is made
  attemptNumber   Int      @default(1)
  scheduledAt     DateTime?
  attemptedAt     DateTime?
  connectedAt     DateTime?
  // Outcome
  outcome         String?  // "answered" | "no_answer" | "busy" | "failed" | "dnc_skipped" | "consent_missing"
  durationSec     Int      @default(0)
  // Personalization
  dynamicVariables String @default(dbgenerated("(_utf8mb4\\'{}\\')")) @db.Text  // JSON: {name, account_id, etc.}
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([campaignId, outcome])
  @@index([toNumber])
}

model CallSummary {
  id              String   @id @default(cuid())
  callId          String   @unique
  call            Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  // Structured summary
  intent          String?
  summary         String @db.LongText
  actionItems     String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON array
  followUpDate    DateTime?
  followUpType    String?  // "callback" | "email" | "sms" | "meeting"
  // Customer signals
  sentimentScore  Float?   // -1 to 1
  satisfactionScore Float? // 0-100
  objections      String? @db.Text  // JSON array
  keywords        String? @db.Text  // JSON array
  // Compliance flags
  complianceFlags String? @db.Text  // JSON array
  // Audit
  generatedBy     String   @default("ai")  // ai | human
  generatedAt     DateTime @default(now())
  reviewedAt      DateTime?
  reviewedBy      String? @db.Text

  @@index([callId])
}

model KnowledgeBase {
  id              String   @id @default(cuid())
  companyId       String
  company         MosCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  description     String? @db.Text
  // Documents in this KB
  documents       KnowledgeDocument[]
  // Embedding config
  embedProvider   String   @default("local")  // local | gemini
  embedModel      String   @default("bge-m3")
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, status])
}

model KnowledgeDocument {
  id              String   @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  // Source
  title           String
  sourceType      String   // "pdf" | "docx" | "txt" | "csv" | "url" | "faq"
  sourceUrl       String? @db.Text  // original URL or storage path
  // Content
  rawText         String @default(dbgenerated("(_utf8mb4\\'\\')")) @db.LongText  // extracted plain text
  chunksCount     Int      @default(0)
  // Permissions
  visibleToAgents String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON array of agentIds; empty = all
  // Status
  status          String   @default("processing")  // processing | indexed | failed | archived
  indexedAt       DateTime?
  // Audit
  uploadedBy      String?
  creator         User?    @relation("KnowledgeDocCreator", fields: [uploadedBy], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([knowledgeBaseId, status])
  chunks          KnowledgeChunk[]
}

model KnowledgeChunk {
  id              String   @id @default(cuid())
  documentId      String
  document        KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Chunk content
  chunkIndex      Int
  text            String @db.LongText
  // Embedding (stored as base64 or vector reference)
  embedding       String? @db.LongText  // base64-encoded Float32Array; null until indexed
  // Source reference (for citations)
  sourceLocation  String? @db.Text  // e.g. "page 5, paragraph 2"
  // Retrieval audit
  retrievalCount  Int      @default(0)
  lastRetrievedAt DateTime?
  createdAt       DateTime @default(now())

  @@index([documentId, chunkIndex])
}

// ==================== PHASE 5: HUMAN CONTACT CENTER + CRM ====================

model AgentStatus {
  id              String   @id @default(cuid())
