model SharedInboxMessage {
  id              String   @id @default(cuid())
  companyId       String
  company         MosCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Channel
  channel         String   // "voice" | "sms" | "email" | "web_chat" | "whatsapp_disabled"
  // Direction
  direction       String   // "inbound" | "outbound"
  // Parties
  fromAddress     String @db.Text
  toAddress       String @db.Text
  fromName        String?
  toName          String?
  // Content
  subject         String? @db.Text
  body            String @db.LongText
  mediaUrls       String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON array
  // Threading
  threadId        String?
  // Assignment
  assignedToId    String?  // user id
  // Status
  status          String   @default("unread")  // unread | read | pending_reply | resolved | escalated
  isAiGenerated   Boolean  @default(false)  // per directive §14: distinguish AI vs provider-confirmed
  isProviderConfirmed Boolean @default(false)  // set true when SMS/email delivery receipt arrives
  // Tags + internal notes
  tags            String @default(dbgenerated("(_utf8mb4\\'[]\\')")) @db.Text  // JSON array
  internalNotes   String? @db.Text  // for internal context (not sent to customer)
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

