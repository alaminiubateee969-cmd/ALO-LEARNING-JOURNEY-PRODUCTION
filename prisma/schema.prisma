// ==================== INTEGRATIONS (v1 API surface) ====================
// Supports OAuth Authorization Code + PKCE flows and manual credential
// storage. All secrets are encrypted with AES-256-GCM via the vault
// (src/lib/vault.ts) and stored in IntegrationSecret. The plaintext is
// never persisted and never returned by any API route.

model Integration {
  id              String   @id @default(cuid())
  // Globally unique connection id surfaced in the API as {connection_id}
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Provider slug: google, youtube, meta, linkedin, x, tiktok, pinterest,
  // wordpress, hubspot, stripe, shopify, google_search_console, ga4, gtm,
  // google_ads, mailchimp, sendgrid, etc.
  provider        String
  // Connection method that produced this integration
  authMethod      String   @default("oauth")  // oauth | manual
  // Connection-level status (separate from credential_status)
  status          String   @default("pending")  // pending | connected | action_required | expired | revoked | unavailable | error
  // OAuth scopes granted by the user (JSON array — non-secret)
  grantedScopes   String   @default("[]")
  // Resources selected by the user (de-normalised copy for fast reads)
  selectedResources String  @default("[]")  // JSON array of {type, id, name}
  // OAuth state id (FK to OAuthState) used during the in-flight authorize flow
  currentStateId  String?
  // Token expiry (iso) — populated on callback; used by daily health check
  tokenExpiresAt  DateTime?
  // Refresh token rotation supported?
  refreshSupported Boolean @default(false)
  // Last successful validation (health check)
  lastValidatedAt DateTime?
  // User who created/last-modified this integration
  createdBy       String?
  creator         User?    @relation("IntegrationCreator", fields: [createdBy], references: [id])
  updatedBy       String?
  updater         User?    @relation("IntegrationUpdater", fields: [updatedBy], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  secrets         IntegrationSecret[]
  resources       IntegrationResource[]
  logs            IntegrationLog[]

  @@index([companyId, provider])
  @@unique([companyId, provider])  // one connection per provider per company
}

model IntegrationSecret {
  id              String   @id @default(cuid())
  integrationId   String
  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  // Which secret this is: access_token, refresh_token, api_key, app_secret,
  // developer_token, webhook_signing_secret, service_account_json, etc.
  kind            String
  // AES-256-GCM envelope: iv:ciphertext:authTag (all base64). Never plaintext.
  ciphertext      String
  // Key version of the master key that encrypted this (for rotation)
  keyVersion      Int      @default(1)
  // Masked value shown to the user, e.g. "****x7Kq" — never the secret itself
  maskedValue     String?
  // When this secret was last rotated/refreshed
  rotatedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([integrationId, kind])
  @@index([integrationId])
}

model IntegrationResource {
  id              String   @id @default(cuid())
  integrationId   String
  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  // Resource type per provider vocabulary: youtube_channel, search_console_site,
  // ga4_property, gtm_container, fb_page, ig_account, ad_account, pixel,
  // wa_ba, wa_phone_number_id, linkedin_page, wp_site, etc.
  type            String
  // Provider's resource id (channel id, property id, page id, site url, etc.)
  resourceId      String
  // Human-readable name (channel title, page name, property name)
  name            String?
  // Permission level the user has on this resource (owner, admin, user, etc.)
  permission      String?
  // Whether the user explicitly selected this resource
  selected        Boolean  @default(false)
  // Whether the resource is reachable on the provider API right now
  status          String   @default("valid")  // valid | action_required | expired | unavailable
  // Raw metadata returned by discovery (non-secret)
  metadata        String   @default("{}")  // JSON
  discoveredAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([integrationId, type, resourceId])
  @@index([integrationId, type])
}

model IntegrationLog {
  id              String   @id @default(cuid())
  integrationId   String
  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  // Action performed: authorize, callback, discover, select_resources,
  // validate, refresh, revoke, disconnect, secret_rotate
  action          String
  // Outcome: success | failure | pending
  outcome         String   @default("success")
  // Non-secret message (error reason, scope delta, etc.)
  message         String?
  // Who initiated the action
  actorUserId     String?
  // Source: ui | api | agent | scheduler | webhook
  source          String   @default("api")
  createdAt       DateTime @default(now())

  @@index([integrationId, createdAt])
}

// In-flight OAuth state — short-lived (10 min), unique per authorize call,
// tied to the user + provider + PKCE verifier. Cleared on callback or expiry.
model OAuthState {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation("OAuthStateUser", fields: [userId], references: [id], onDelete: Cascade)
  provider        String
  // High-entropy random — bound to the user's session, validated on callback
  state           String   @unique
  // PKCE code_verifier (S256 challenge). Never sent to the provider.
  codeVerifier    String
  // The redirect URI the provider should send the user back to
  redirectUri     String
  // Requested scopes (JSON array)
  scopes          String   @default("[]")
  // Auto-expire so abandoned authorizations don't accumulate
  expiresAt       DateTime
  // Set to true on successful callback so re-use is rejected
  consumed        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, provider])
  @@index([expiresAt])
}

// Manifest produced at end of Phase 9 (client confirmation). Stored
// permanently as the canonical integration summary — never contains
// plaintext secrets.
model IntegrationManifest {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Project / workspace grouping
  projectId       String?
  workspaceId     String?
  // JSON: list of {provider, connection_id, credential_reference (vault://),
  // resources[], status}
  manifest        String   @default("{}")
  // When the user confirmed the setup
  confirmedAt     DateTime @default(now())
  // Who confirmed
  confirmedBy     String?
  confirmer       User?    @relation("ManifestConfirmer", fields: [confirmedBy], references: [id])
  createdAt       DateTime @default(now())

  @@index([companyId])
}

// ==================== AI MODEL REGISTRY (Super Admin) ====================
// Configurable free-model providers + model entries. Super admins add
// providers (OpenCode, Ollama, OpenRouter, Groq, Gemini, Z.AI, etc.) and
// per-provider model entries (model id, context window, capabilities).
// The ai-chain.ts reads from this table at runtime so the chain is hot-
// swappable without code changes or restarts.
//
// Security: only super_admin role can CRUD these rows. API keys are
// encrypted via the vault (IntegrationSecret pattern) before storage.

model AiModelProvider {
  id              String   @id @default(cuid())
  // Slug: opencode, ollama, openrouter, groq, gemini, zai, cloudflare, mistral, hf
  slug            String   @unique
  label           String
  // Display category for the admin UI
  category        String   @default("free")  // free | paid | self-hosted | hybrid
  // Base URL the chain calls (e.g. https://api.groq.com/openai/v1)
  baseUrl         String?
  // Whether the provider speaks OpenAI-compatible /v1/chat/completions
  openAiCompatible Boolean @default(true)
  // Whether this provider can be used without an API key (local Ollama)
  apiKeyOptional  Boolean @default(false)
  // Where the API key lives when set: env var name (e.g. GROQ_API_KEY)
  // — if null, the key is stored encrypted in AiModelProvider.secretCipher
  apiKeyEnvName   String?
  // AES-256-GCM envelope ciphertext of the API key (when not env-var-driven)
  secretCipher    String?
  secretKeyVersion Int     @default(1)
  secretMasked    String?
  // Whether the super admin has enabled this provider in the active chain
  isEnabled       Boolean  @default(true)
  // Sort priority — lower = earlier in the chain
  priority        Int      @default(100)
  // Health check
  lastCheckedAt   DateTime?
  lastStatus      String?  // ok | rate_limited | auth_failed | unreachable | unknown
  lastError       String?
  // Documentation link for the admin UI
  docsUrl         String?
  // Free-tier rate limit info (display only)
  rateLimitNote   String?
  // Notes for other admins
  notes           String?
  // Audit
  createdBy       String?
  creator         User?    @relation("AiModelProviderCreator", fields: [createdBy], references: [id])
  updatedBy       String?
  updater         User?    @relation("AiModelProviderUpdater", fields: [updatedBy], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  models          AiModelEntry[]
  agentAssignments AgentModelAssignment[]
  circuitBreaker  CircuitBreakerState?

  @@index([isEnabled, priority])
}

model AiModelEntry {
  id              String   @id @default(cuid())
  providerId      String
  provider        AiModelProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  // Model id sent in the API request body (e.g. "llama-3.3-70b-versatile")
  modelId         String
  // Human-readable display name (e.g. "Llama 3.3 70B Versatile")
  displayName     String
  // Context window in tokens (helps the chain pick the right model)
  contextWindow   Int      @default(8192)
  // Capabilities: JSON array ["chat", "vision", "tools", "json_mode"]
  capabilities    String   @default("[\"chat\"]")
  // Whether this model is the default fallback for the provider
  isDefault       Boolean  @default(false)
  // Whether this model is enabled in the chain
  isEnabled       Boolean  @default(true)
  // Estimated throughput for admin display
  maxOutputTokens Int      @default(4096)
  // Free-tier notes (e.g. "6 requests/min on free tier")
  freeTierNote    String?
  // Audit
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  agentAssignments AgentModelAssignment[]

  @@unique([providerId, modelId])
  @@index([providerId, isEnabled])
}

// ==================== AGENT MODEL ASSIGNMENT + BUDGET + CIRCUIT BREAKER =====
// Per-agent model selection + budget tracking + circuit breaker state +
// execution log (model, latency, tokens, cost, errors) for the entire
// AI agent loop. All fields are tenant-scoped via companyId.

// Maps an agent type (seo, content, whatsapp, sms, lead_qualifier, crm,
// etc.) to a specific provider+model. When the agent runs, the chain
// uses this assignment FIRST before falling through to the default chain.
model AgentModelAssignment {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Agent type slug — matches AiAgent.type from existing schema
  agentType       String
  // FK to provider + model entry (both required)
  providerId      String
  provider        AiModelProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelId         String
  model           AiModelEntry   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  // Whether this assignment is active
  isEnabled       Boolean  @default(true)
  // Daily token budget cap for this agent (across all runs)
  dailyTokenBudget Int     @default(100000)
  // Daily request cap
  dailyRequestBudget Int    @default(100)
  // Audit
  createdBy       String?
  creator         User?    @relation("AgentAssignmentCreator", fields: [createdBy], references: [id])
  updatedBy       String?
  updater         User?    @relation("AgentAssignmentUpdater", fields: [updatedBy], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, agentType])
  @@index([companyId, isEnabled])
}

// Per-provider circuit breaker state. When consecutive failures exceed
// `failureThreshold`, the breaker opens and short-circuits all calls to
// this provider for `cooldownSeconds`. After cooldown, a single probe
// request is allowed (half-open); on success the breaker closes, on
// failure it re-opens.
model CircuitBreakerState {
  id              String   @id @default(cuid())
  providerId      String   @unique
  provider        AiModelProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  state           String   @default("closed")  // closed | open | half_open
  consecutiveFailures Int  @default(0)
  consecutiveSuccesses Int @default(0)
  lastFailureAt   DateTime?
  lastFailureReason String?
  lastSuccessAt   DateTime?
  trippedAt       DateTime?
  // Number of times the breaker has tripped to "open" — for monitoring
  tripCount       Int      @default(0)
  updatedAt       DateTime @updatedAt
}

// Per-agent per-day usage tracking. Rolled up from AgentExecutionLog
// rows. Used to enforce dailyTokenBudget / dailyRequestBudget caps.
model AgentUsageDaily {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentType       String
  // YYYY-MM-DD (UTC) — daily bucket
  day             String
  // Aggregated usage
  requestCount    Int      @default(0)
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  totalTokens     Int      @default(0)
  // Estimated cost in USD (provider billing rate × tokens)
  estimatedCostUsd Float   @default(0)
  // Number of failures + fallbacks
  failureCount    Int      @default(0)
  fallbackCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, agentType, day])
  @@index([companyId, day])
}

// Per-execution audit log. One row per AI call. Records model, latency,
// tokens, cost, errors, and whether the result was used or discarded.
model AgentExecutionLog {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentType       String
  // Which provider+model actually served the request
  providerSlug    String
  modelName       String
  // Input shape
  promptCharCount Int      @default(0)
  // Output shape
  responseCharCount Int    @default(0)
  // Token usage (when reported by provider)
  promptTokens    Int?
  completionTokens Int?
  totalTokens     Int?
  // Estimated cost in USD
  estimatedCostUsd Float?
  // Performance
  latencyMs       Int
  // Outcome
  success         Boolean
  errorMessage    String?
  // Whether the response was discarded (filtered, PII scrub, schema fail)
  discardedReason String?
  // Whether a fallback provider served this request
  usedFallback    Boolean  @default(false)
  // User who triggered the run (if applicable)
  actorUserId     String?
  actor           User?    @relation("AgentExecutionActor", fields: [actorUserId], references: [id])
  // PII scrub log — how many PII entities were redacted before the call
  piiRedactionCount Int    @default(0)
  createdAt       DateTime @default(now())

  @@index([companyId, agentType, createdAt])
  @@index([providerSlug, createdAt])
}

// After-hours routing rules per company. Defines when inquiries are
// queued for the next business hour vs. handled live.
model AfterHoursRule {
  id              String   @id @default(cuid())
  companyId       String   @unique
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // IANA timezone — defaults to Asia/Dhaka per master directive
  timezone        String   @default("Asia/Dhaka")
  // JSON array of weekday numbers that are working days
  // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  workingDays     String   @default("[1,2,3,4,5]")  // Mon-Fri default
  // HH:MM in the configured timezone
  workingStart    String   @default("09:00")
  workingEnd      String   @default("18:00")
  // JSON array of {date: "YYYY-MM-DD", name: "..."} for public holidays
  holidays        String   @default("[]")
  // What to do with inbound messages outside working hours
  // queue | auto_reply_with_disclaimer | emergency_only
  afterHoursPolicy String  @default("auto_reply_with_disclaimer")
  // Disclaimer text appended to auto-replies during off-hours
  afterHoursDisclaimer String?
  updatedAt       DateTime @updatedAt
}
