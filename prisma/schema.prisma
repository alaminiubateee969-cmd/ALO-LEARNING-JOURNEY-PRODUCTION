  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  // Billing cycle
  billingCycle   String   @default("monthly")  // monthly | yearly
  startsAt       DateTime @default(now())
  endsAt         DateTime?
  // Trial
  isTrial        Boolean  @default(false)
  trialEndsAt    DateTime?
  // Status
  status         String   @default("active")  // active | past_due | cancelled | suspended
  cancelledAt    DateTime?
  // Payment method reference (provider-specific)
  paymentMethodRef String? @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UsageCredit {
  id              String   @id @default(cuid())
  companyId       String
  company         MosCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Credit type
  creditType      String   // "ai_minutes" | "tts_chars" | "asr_seconds" | "recording_mb" | "outbound_calls"
  // Balance
  balance         Float    @default(0)
  // Auto-recharge
  autoRechargeThreshold Float @default(0)
  autoRechargeAmount Float @default(0)
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, creditType])
}

model MosInvoice {
  id              String   @id @default(cuid())
  companyId       String
  company         MosCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Invoice number (human-readable)
  invoiceNumber   String   @unique
  // Period
  periodStart     DateTime
  periodEnd       DateTime
  // Amounts (USD)
  subtotal        Float
  tax             Float    @default(0)
  total           Float
  // Currency
  currency        String   @default("USD")
  // Line items (JSON array of { description, quantity, unitPrice, total })
  lineItems       String @db.Text
  // Status
  status          String   @default("draft")  // draft | sent | paid | past_due | void | refunded
  sentAt          DateTime?
  paidAt          DateTime?
  dueAt           DateTime?
  // Payment
  paymentMethodRef String? @db.Text
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, status])
  payments        Payment[]
}

model Payment {
  id              String   @id @default(cuid())
  companyId       String
  company         MosCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceId       String?
  invoice         MosInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  // Amount
  amount          Float
  currency        String   @default("USD")
  // Provider
  provider        String   // "stripe" | "sslcommerz" | "manual" | "bank_transfer"
  providerPaymentId String?
  // Method
  method          String   // "card" | "bank" | "wallet" | "manual"
  // Status
  status          String   @default("pending")  // pending | succeeded | failed | refunded | disputed
  processedAt     DateTime?
  failureReason   String? @db.Text
  // Audit
  createdBy       String?
  creator         User?    @relation("PaymentCreator", fields: [createdBy], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, status])
}

model BillingAdjustment {
  id              String   @id @default(cuid())
  companyId       String
  company         MosCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Type
  type            String   // "credit" | "charge" | "refund" | "waiver"
  // Amount (positive number; sign determined by type)
  amount          Float
  currency        String   @default("USD")
  // Reason
  reason          String @db.Text
  // Reference (optional)
