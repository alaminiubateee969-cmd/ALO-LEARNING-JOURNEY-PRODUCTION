{
  "name": "learn-aloeducation",
  "version": "0.2.1",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "build:prod": "prisma generate && next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "start:prod": "NODE_ENV=production node .next/standalone/server.js",
    "start:node": "NODE_ENV=production node .next/standalone/server.js",
    "start:bun": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "cpanel:build": "npm ci && prisma generate && npm run build",
    "cpanel:start": "node scripts/cpanel-start.mjs",
    "cpanel:health": "node scripts/cpanel-health.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:sharp": "node --test tests/image-processing.test.mjs",
    "test:integration": "tsx scripts/verify-login.ts && tsx scripts/test-integrations.ts && tsx scripts/test-ollama-cloud.ts && tsx scripts/test-sms-providers.ts && tsx scripts/test-voice-contact-center.ts",
    "verify": "npm run typecheck && npm run lint && npm test",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "test:migrations:integration": "node scripts/test-migrations.mjs",
    "db:push": "node scripts/prisma-dev-guard.mjs push",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/prisma-dev-guard.mjs migrate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "node scripts/prisma-dev-guard.mjs reset",
    "postinstall": "prisma generate"
  },
