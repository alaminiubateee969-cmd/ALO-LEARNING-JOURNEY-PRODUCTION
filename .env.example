# ALO Learning Journey — Environment Configuration
# Copy to .env and fill with real values. NEVER commit the real .env.

# ============================================================
# CORE APPLICATION
# ============================================================
NODE_ENV=production
PORT=3017
# Comma-separated list of allowed dev preview origins (for the Caddy gateway)
ALLOWED_DEV_ORIGINS="preview-*.space-z.ai"

# ============================================================
# DATABASE
# ============================================================
# SQLite (development + single-instance production)
DATABASE_URL="file:./db/custom.db"
# For MySQL/Postgres, replace with: mysql://user:pass@host:3306/dbname
# or postgresql://user:pass@host:5432/dbname

# ============================================================
# AUTHENTICATION (NextAuth v4) — REQUIRED FOR PRODUCTION
# ============================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://learn.aloeducation.com"
# Admin login credentials
ALO_ADMIN_EMAIL="admin@aloeducation.com"
# Generate with: bun run scripts/hash-password.ts <password>
ALO_ADMIN_PASSWORD_HASH="bcrypt-hash-from-hash-password-script"
# If all three vars above are unset → app runs in DEV_AUTH mode (any creds accepted).
# NEVER enable dev-auth in production — all APIs would be open.

# ============================================================
# CRON / BACKGROUND
# ============================================================
# Required for /api/recovery/sweep when auth is enabled (cron job calls this)
CRON_SECRET="generate-with-openssl-rand-base64-32"

# ============================================================
# AI PROVIDER (z-ai-web-dev-sdk)
# ============================================================
# The SDK reads its own credentials from env. Configure per the SDK docs.
# No ALO-specific key needed here, but ensure the SDK can authenticate.

# ============================================================
# LIP-SYNC (OPTIONAL — external GPU service)
# ============================================================
# Deploy Wav2Lip / SadTalker / VideoReTalking on a GPU box.
# When unset, avatar videos fall back to talking-portrait mode (no lip movement).
# LIPSYNC_SERVICE_URL="http://gpu-box:8080/predict"
# LIPSYNC_PROVIDER="wav2lip"  # wav2lip | sadtalker | videoretalking
# LIPSYNC_TIMEOUT_MS="120000"
# LIPSYNC_API_KEY=""           # if the service requires bearer auth
# LIPSYNC_IMAGE_FIELD="image"  # multipart field name for portrait
# LIPSYNC_AUDIO_FIELD="audio"  # multipart field name for audio
# LIPSYNC_EXTRA_FIELDS='{"pads":"0 10 0 0","resize_factor":"1"}'

# ============================================================
# OBSERVABILITY
# ============================================================
# JSON structured logs to stdout. Set to "debug" for verbose stage logs.
LOG_LEVEL="info"

# ============================================================
# STORAGE (only override if using non-default paths)
# ============================================================
# UPLOAD_DIR="storage/uploads"
