# ALO Learning Journey — Environment Configuration
# Copy to .env and fill values. Never commit real credentials.

# Database (prisma/schema.prisma uses MySQL; SQLite is not supported)
# Replace the placeholder with a new, URL-encoded password before use.
DATABASE_URL="mysql://user_learn:REPLACE_WITH_NEW_URL_ENCODED_PASSWORD@127.0.0.1:3306/db_learn"

# Authentication is NOT implemented: next-auth is installed but there is no
# auth handler, session validation, or route protection. These variables alone
# do not secure the application. Do not expose this app publicly until auth/RBAC
# is implemented and verified.
# NEXTAUTH_URL="https://learn.aloeducation.com"
# NEXTAUTH_SECRET="generate-a-unique-secret-outside-the-repository"

# AI: current source uses z-ai-web-dev-sdk with local fallbacks. There is no
# OpenAI adapter, and OPENAI_API_KEY is not currently consumed by the app.

# Social OAuth (all optional — EXTERNAL_SETUP_REQUIRED without these)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# INSTAGRAM_APP_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# LINKEDIN_CLIENT_ID=
# TWITTER_CLIENT_ID=
# PINTEREST_APP_ID=

# Communication (all optional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# WHATSAPP_BUSINESS_TOKEN=
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@aloeducation.com

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_IDS=8847234

# Inkbox (optional adapter)
# INKBOX_ENDPOINT=
# INKBOX_API_KEY=

# Storage
UPLOAD_DIR=./storage/uploads
VIDEO_DIR=./storage/videos

# Production
PORT=3017
NODE_ENV=production
