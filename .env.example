# ALO Learning Journey — Environment Configuration
# Copy to .env and fill values. Never commit real credentials.

# Database (prisma/schema.prisma uses MySQL; SQLite is not supported)
# Replace the placeholder with a new, URL-encoded password before use.
DATABASE_URL="mysql://user_learn:REPLACE_WITH_NEW_URL_ENCODED_PASSWORD@127.0.0.1:3306/db_learn"
# Dev-only schema commands (db:push, db:migrate, db:reset) are guarded.
# They require a DB name containing dev/test/scratch/disposable plus explicit,
# exact-name confirmations. Never set these for production or CI.
# ALO_DEV_DB_CONFIRM=<development-database-name>
# ALO_CONFIRM_DB_PUSH=<development-database-name>
# ALO_CONFIRM_MIGRATE_DEV=<development-database-name>
# ALO_CONFIRM_DB_RESET=<development-database-name>
# ALO_REMOTE_DEV_DB_NAME=<development-database-name>  # remote dev DB only

# Administrator authentication (single account; RBAC / multi-user roles are not implemented)
# Production requires password + SMS OTP and fails closed unless all listed auth values are configured.
# NEXTAUTH_URL="https://learn.aloeducation.com"
# NEXTAUTH_SECRET="generate-a-unique-secret-outside-the-repository"
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD_HASH="scrypt$<base64url-salt>$<base64url-hash>"
# Create a hash without putting the password in shell history:
#   read -rsp 'Admin password: ' p && printf '%s' "$p" | node scripts/hash-admin-password.mjs && unset p
# Fixed E.164 admin phone; the httpSMS-compatible gateway queues the code to its Android handset.
# SMS delivery is external and may incur carrier/provider charges; an HTTP 202 means queued, not delivered.
# ADMIN_OTP_PHONE="+8801XXXXXXXXX"
# HTTPSMS_API_KEY=
# HTTPSMS_FROM="+8801XXXXXXXXX"
# HTTPSMS_BASE_URL="https://api.httpsms.com"  # Optional; use a self-hosted HTTPS endpoint if configured.
# Local development bypasses auth for preview convenience. Set ALO_REQUIRE_AUTH=true to test login locally.
# Set ADMIN_OTP_REQUIRED=true to test the SMS second factor in development.
# ALO_REQUIRE_AUTH=false
# ADMIN_OTP_REQUIRED=false

# AI generation is local-only by default. External features require both switches below;
# leave false unless the owner has reviewed provider pricing/terms and explicitly approved use.
ALO_PAID_AI_API_ALLOWED=false
ALO_OWNER_APPROVED_PAID_AI_API=false
# Optional direct external FREE providers — see LOCAL_AI.md. Used ONLY as a
# fallback for allowlisted non-personal content drafts (ideas / content
# package / opportunity score / hooks / content brief) when the local model
# is unavailable. Never for comments, protective review, commands, narration,
# song, email drafts, or student/family data. Requires BOTH switches =true
# plus at least one provider key below. Providers are tried in this order
# (subset/reorder freely; unknown names are ignored):
# ALO_EXTERNAL_AI_PROVIDERS=groq,llm7,opencode,openrouter,omniroute
# Groq — free key: https://console.groq.com
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# LLM7 — free token: https://token.llm7.io (models: default/fast/free ids; "pro" is paid and blocked)
# LLM7_API_KEY=
# LLM7_MODEL=default
# OpenCode Zen — key: https://opencode.ai/auth (free: big-pickle or *-free models only)
# OPENCODE_API_KEY=
# OPENCODE_MODEL=big-pickle
# OpenRouter — key: https://openrouter.ai/settings/keys (free: openrouter/free or *:free models only)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# ── Owner gateways ("add a provider like OmniRoute") ──────────────────────
# OmniRoute, self-hosted by you (https://github.com/diegosouzapw/OmniRoute).
# Create an API key inside your OmniRoute dashboard. Default base is your
# local server; plain http is accepted only for loopback/private hosts.
# OMNIROUTE_API_KEY=
# OMNIROUTE_MODEL=auto
# OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# Any other OpenAI-compatible gateway (LiteLLM, 9router, LM Studio, vLLM…)
# as a JSON array, max 5. Keys are referenced by env NAME only — never put a
# literal key in this JSON. Public gateways must use https.
# ALO_CUSTOM_AI_PROVIDERS_JSON=[{"id":"my-gateway","name":"My Gateway","baseUrl":"https://llm.example.com/v1","apiKeyEnv":"MY_GATEWAY_API_KEY","model":"best-free"}]
# MY_GATEWAY_API_KEY=
# Install Ollama and pull a Bengali-capable instruction model on this machine first.
# Public hosts are rejected by the adapter; use loopback, a private IP, or a local
# Docker service name such as http://ollama:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional local ComfyUI image generation (no RunningHub/cloud endpoint).
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Must match a checkpoint already installed in ComfyUI/models/checkpoints.
# COMFYUI_CHECKPOINT=your-local-checkpoint.safetensors

# Local speech: Piper is preferred when a compatible model is installed; eSpeak is fallback.
# PIPER_BIN=piper
# PIPER_MODEL_PATH=/opt/alo/models/bn_voice.onnx
# ESPEAK_BIN=espeak
VIDEO_FONT_PATH=./public/fonts/HindSiliguri-Bold.ttf

# Social OAuth (all optional — EXTERNAL_SETUP_REQUIRED without these)
# ── Social OAuth (RESERVED — NOT YET WIRED) ─────────────────────────────────
# The social connect flow currently reports "external_setup_required" and
# stores no tokens (src/app/api/social/route.ts). Keep these commented out
# until the OAuth callback flow is implemented; they are read by nothing today.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# INSTAGRAM_APP_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# LINKEDIN_CLIENT_ID=
# TWITTER_CLIENT_ID=
# PINTEREST_APP_ID=

# Telegram: not connected. /api/telegram is an administrator-only in-app
# command console; there is no Telegram webhook, message delivery, or scheduler.

# Inkbox (optional adapter)
# INKBOX_ENDPOINT=
# INKBOX_API_KEY=

# Storage
UPLOAD_DIR=./storage/uploads
VIDEO_DIR=./storage/videos

# Application backup snapshots use AES-256-GCM but are partial and not restorable.
# Production requires a dedicated BACKUP_ENCRYPTION_KEY of at least 32 characters;
# non-production may derive from NEXTAUTH_SECRET or create a local ignored key.
# BACKUP_ENCRYPTION_KEY=

# Optional debugging / behaviour toggles
# ALO_PRISMA_LOG=true            # Log Prisma queries (never enable in production)
# ALO_DISABLE_BUILTIN_LOCAL_AI=true  # Disable the built-in procedural/template fallbacks
# ENV_FILE=.env                  # Env file read by scripts/deploy-production.sh

# Production
PORT=3017
NODE_ENV=production
