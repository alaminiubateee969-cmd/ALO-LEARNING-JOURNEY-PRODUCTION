# ALO Learning Journey — Environment Configuration
# Copy to .env and fill values. Never commit real credentials.

# Database
DATABASE_URL="file:./db/custom.db"

# NextAuth (when implementing auth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-32-char-random-string"

# AI Provider (z-ai-web-dev-sdk — pre-configured, no key needed in sandbox)
# For production with OpenAI: OPENAI_API_KEY=sk-your-key

# Social OAuth (all optional — EXTERNAL_SETUP_REQUIRED without these)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# INSTAGRAM_APP_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# LINKEDIN_CLIENT_ID=
# TWITTER_CLIENT_ID=
# PINTEREST_APP_ID=

# Communication (all optional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# WHATSAPP_BUSINESS_TOKEN=
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@aloeducation.com

# Telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_IDS=8847234

# Inkbox (optional adapter)
# INKBOX_ENDPOINT=
# INKBOX_API_KEY=

# Storage
UPLOAD_DIR=./storage/uploads
VIDEO_DIR=./storage/videos

# Production
PORT=3017
NODE_ENV=production
